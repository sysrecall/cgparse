# Copy this file to `.env` at the repo root and fill in the values.
# The Python services either read it through pydantic-settings or receive it via
# `set -a && source ../../.env && set +a` (see the README).
# The web app uses its own file: `apps/web/.env.local`.

# ─── Shared (both Python services read these) ────────────────────────────────
# Supabase Postgres (pgvector enabled) — use the pooled connection string (port 6543)
DATABASE_URL=postgresql+psycopg://user:password@host:6543/dbname
# Dedicated Supabase **dev** project for integration tests + the eval harness.
# Never point this at the live database — DB tests truncate every table.
# When set, the test suites alias it to DATABASE_URL so app_core.settings uses it.
TEST_DATABASE_URL=postgresql+psycopg://user:password@dev-host:5432/dbname
# Upstash Redis (broker + result backend + pub/sub)
REDIS_URL=rediss://default:password@host:6379

# ─── Tigris object storage (S3-compatible; boto3 reads AWS_* natively) ───────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
# Optional: only needed when calling Tigris's IAM API. The app itself only uses S3.
# AWS_ENDPOINT_URL_IAM=https://iam.storage.dev
AWS_REGION=auto
TIGRIS_BUCKET=careguide

# ─── services/api (all optional; the values below are the defaults) ──────────
# JWT settings are reserved for the auth milestone; no endpoint reads them in v1.
API_JWT_SECRET=change-me
API_JWT_EXPIRES_MINUTES=60
# Comma-separated list of allowed browser origins.
API_CORS_ORIGINS=http://localhost:3000
# Per-file upload limit, in megabytes.
API_MAX_UPLOAD_MB=200

# ─── services/processing ─────────────────────────────────────────────────────
# Bare OPENPARSER_API_KEY / LLM_API_KEY are accepted as aliases.
PROC_OPENPARSER_API_KEY=...
PROC_LLM_API_KEY=...
PROC_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
PROC_LLM_MODEL=openai/gpt-oss-20b

# ─── embeddings (semantic search; both services read these) ──────────────────
# Falls back to PROC_LLM_API_KEY / LLM_API_KEY, so the NVIDIA key above is enough.
# EMBED_DIMENSIONS must match text_chunks.embedding (the model is natively 2048).
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=32

# ─── apps/web (copy this line into apps/web/.env.local, not the repo root) ───
# NEXT_PUBLIC_API_URL=http://localhost:8000
