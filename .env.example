# ─── Shared (both Python services read these) ────────────────────────────────
# Supabase Postgres (pgvector enabled) — use the pooled connection string (port 6543)
DATABASE_URL=postgresql+psycopg://user:password@host:6543/dbname
# Upstash Redis (broker + result backend + pub/sub)
REDIS_URL=rediss://default:password@host:6379

# ─── Tigris object storage (S3-compatible; boto3 reads AWS_* natively) ───────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
# Bucket name (env var name per your choice — see chat)
TIGRIS_BUCKET=docintel-dev

# ─── services/api ────────────────────────────────────────────────────────────
API_JWT_SECRET=change-me
API_JWT_EXPIRES_MINUTES=60
API_CORS_ORIGINS=http://localhost:3000
API_MAX_UPLOAD_MB=200

# ─── services/processing ─────────────────────────────────────────────────────
PROC_OPENPARSER_API_KEY=...
PROC_LLM_API_KEY=...
PROC_LLM_BASE_URL=https://openrouter.ai/api/v1
PROC_LLM_MODEL=openai/gpt-4o-mini
